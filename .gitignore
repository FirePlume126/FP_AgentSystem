# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*
!Plugins/FPAgentSystem/Binaries/*
!Plugins/FPAgentSystem/Binaries/Win64/*
Plugins/FPAgentSystem/Binaries/Win64/*.pdb

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*
!Plugins/FPAgentSystem/Intermediate/Build/
!Plugins/FPAgentSystem/Intermediate/Build/Win64/
!Plugins/FPAgentSystem/Intermediate/Build/Win64/UnrealGame/
Plugins/FPAgentSystem/Intermediate/Build/Win64/UnrealGame/Inc/
Plugins/FPAgentSystem/Intermediate/Build/Win64/UnrealGame/Shipping/
Plugins/FPAgentSystem/Intermediate/Build/Win64/UnrealEditor/
!Plugins/FPAgentSystem/Intermediate/Build/Win64/x64/UnrealGame/Development/FPAgentSystem/*.obj

# Cache files for the editor to use
DerivedDataCache/*

# Custom lgnore
Content/Collections/*
Content/Developers/*
Platforms/*

# Source lgnore
!Plugins/FPAgentSystem/Source/
!Plugins/FPAgentSystem/Source/FPAgentSystem/
Plugins/FPAgentSystem/Source/FPAgentSystem/Public/
Plugins/FPAgentSystem/Source/FPAgentSystem/Private/
!Plugins/FPAgentSystem/Source/FPAgentSystemEditor/
Plugins/FPAgentSystem/Source/FPAgentSystemEditor/Public/
Plugins/FPAgentSystem/Source/FPAgentSystemEditor/Private/
